          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"service_reminders\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"vehicle_id\" INTEGER NOT NULL, \"maintenance_record_id\" INTEGER NOT NULL, \"target_date\" INTEGER NULL, \"target_odometer_km\" INTEGER NULL, UNIQUE (\"maintenance_record_id\"), CHECK (target_date IS NOT NULL OR target_odometer_km IS NOT NULL), CHECK (target_odometer_km IS NULL OR target_odometer_km >= 0), FOREIGN KEY (vehicle_id) REFERENCES vehicles(id) ON UPDATE CASCADE ON DELETE RESTRICT, FOREIGN KEY (maintenance_record_id, vehicle_id) REFERENCES maintenance_records(id, vehicle_id) ON UPDATE CASCADE ON DELETE CASCADE);"
        }
