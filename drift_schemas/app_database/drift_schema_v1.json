  "fixed_sql": [
    {
      "name": "vehicles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vehicles\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"display_name\" TEXT NOT NULL, \"registration_number\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"retired_at\" INTEGER NULL, CHECK ((is_active = 1 AND retired_at IS NULL) OR (is_active = 0 AND retired_at IS NOT NULL)));"
        }
      ]
    },
    {
      "name": "fuel_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fuel_events\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"vehicle_id\" INTEGER NOT NULL REFERENCES vehicles (id) ON UPDATE CASCADE ON DELETE RESTRICT, \"occurred_at\" INTEGER NOT NULL, \"odometer_km\" INTEGER NOT NULL, \"fuel_brand\" TEXT NOT NULL, \"fuel_volume_millilitres\" INTEGER NOT NULL, \"cost_sen\" INTEGER NOT NULL, \"is_full_tank\" INTEGER NOT NULL CHECK (\"is_full_tank\" IN (0, 1)), \"trip_distance_metres\" INTEGER NULL, CHECK (odometer_km >= 0), CHECK (fuel_volume_millilitres > 0), CHECK (cost_sen >= 0), CHECK (trip_distance_metres IS NULL OR trip_distance_metres >= 0));"
        }
      ]
    },
    {
      "name": "maintenance_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"maintenance_records\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"vehicle_id\" INTEGER NOT NULL REFERENCES vehicles (id) ON UPDATE CASCADE ON DELETE RESTRICT, \"occurred_at\" INTEGER NOT NULL, \"odometer_km\" INTEGER NOT NULL, \"category\" TEXT NOT NULL, \"workshop\" TEXT NULL, \"total_cost_sen\" INTEGER NOT NULL, \"notes\" TEXT NULL, UNIQUE (\"id\", \"vehicle_id\"), CHECK (odometer_km >= 0), CHECK (total_cost_sen >= 0), CHECK (category IN ('service', 'repairs', 'accessories')));"
        }
      ]
    },
    {
      "name": "maintenance_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"maintenance_items\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"vehicle_id\" INTEGER NOT NULL, \"maintenance_record_id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"cost_sen\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, CHECK (cost_sen >= 0), CHECK (position >= 0), FOREIGN KEY (vehicle_id) REFERENCES vehicles(id) ON UPDATE CASCADE ON DELETE RESTRICT, FOREIGN KEY (maintenance_record_id, vehicle_id) REFERENCES maintenance_records(id, vehicle_id) ON UPDATE CASCADE ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"vehicle_id\" INTEGER NOT NULL, \"maintenance_record_id\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"original_file_name\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL UNIQUE, \"mime_type\" TEXT NOT NULL, \"byte_size\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, CHECK (byte_size >= 0), CHECK (position >= 0), CHECK (kind IN ('image', 'pdf')), FOREIGN KEY (vehicle_id) REFERENCES vehicles(id) ON UPDATE CASCADE ON DELETE RESTRICT, FOREIGN KEY (maintenance_record_id, vehicle_id) REFERENCES maintenance_records(id, vehicle_id) ON UPDATE CASCADE ON DELETE CASCADE);"
        }
      ]
    },
